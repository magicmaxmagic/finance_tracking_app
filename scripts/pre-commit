#!/usr/bin/env bash
# Pre-commit hook for code quality checks
# Copy this file to .git/hooks/pre-commit and chmod +x

set -e

echo "🔍 Running pre-commit checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check for secrets
echo "${YELLOW}Checking for secrets...${NC}"
if command -v gitleaks &> /dev/null; then
  gitleaks detect --verbose
else
  echo "${YELLOW}⚠️  gitleaks not installed, skipping secret detection${NC}"
fi

# Backend checks
if git diff --cached --name-only | grep -q "backend/"; then
  echo "${YELLOW}Running backend checks...${NC}"
  
  cd backend
  
  # Check Python syntax
  echo "  Checking Python syntax..."
  if command -v python3 &> /dev/null; then
    for file in $(git diff --cached --name-only | grep '\.py$'); do
      python3 -m py_compile "$file" 2>/dev/null || {
        echo "${RED}  ✗ Syntax error in $file${NC}"
        exit 1
      }
    done
  fi
  
  # Run flake8 if installed
  if command -v flake8 &> /dev/null; then
    echo "  Running flake8..."
    flake8 app --max-line-length=127 --count --statistics || true
  fi
  
  cd ..
fi

# Frontend checks
if git diff --cached --name-only | grep -q "frontend/"; then
  echo "${YELLOW}Running frontend checks...${NC}"
  
  cd frontend
  
  # Check for console.logs
  echo "  Checking for console.log statements..."
  if git diff --cached | grep -q "console\.log"; then
    echo "${RED}  ✗ Found console.log statements${NC}"
    exit 1
  fi
  
  # Run ESLint if installed
  if command -v npx &> /dev/null && [ -f package.json ]; then
    echo "  Running ESLint..."
    npx eslint src --fix 2>/dev/null || true
  fi
  
  cd ..
fi

echo "${GREEN}✓ Pre-commit checks passed!${NC}"
