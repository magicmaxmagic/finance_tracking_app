# Database
DATABASE_URL=postgresql+asyncpg://finance_user:finance_password@postgres:5432/finance_db

# JWT
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
REFRESH_SECRET_KEY=your-super-refresh-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ACCESS_TOKEN_COOKIE_NAME=access_token
REFRESH_TOKEN_COOKIE_NAME=refresh_token
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
ENCRYPTION_KEY=

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Security headers / hosts
SECURITY_HEADERS_ENABLED=True
ENFORCE_HTTPS=False
ALLOWED_HOSTS=["localhost","127.0.0.1"]
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=True
HSTS_PRELOAD=False
CONTENT_SECURITY_POLICY=

# Upload limits
MAX_ICS_UPLOAD_BYTES=5000000

# Rate limiting / Redis
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
REDIS_URL=

# Token blacklist
ENABLE_TOKEN_BLACKLIST=True
TOKEN_BLACKLIST_PREFIX=token:blacklist:

# Audit logging
AUDIT_LOG_ENABLED=True

# Auth flows
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFY_TOKEN_EXPIRE_HOURS=24

# Metrics
PROMETHEUS_METRICS_ENABLED=True

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_ANNUAL=
STRIPE_SUCCESS_URL=http://localhost:3000/pricing?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/pricing?checkout=cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/settings

# Google Calendar OAuth
GOOGLE_CLIENT_ID=1055436215483-u7h07oja5bq89i924f4k44irsfmcqvi9.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
