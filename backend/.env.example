# Database
DATABASE_URL=postgresql+asyncpg://finance_user:finance_password@postgres:5432/finance_db

# JWT
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
REFRESH_SECRET_KEY=your-super-refresh-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ACCESS_TOKEN_COOKIE_NAME=access_token
REFRESH_TOKEN_COOKIE_NAME=refresh_token
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Rate limiting / Redis
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
REDIS_URL=

# Token blacklist
ENABLE_TOKEN_BLACKLIST=True
TOKEN_BLACKLIST_PREFIX=token:blacklist:

# Audit logging
AUDIT_LOG_ENABLED=True

# Auth flows
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFY_TOKEN_EXPIRE_HOURS=24

# Metrics
PROMETHEUS_METRICS_ENABLED=True
